# SQAG internal-alpha VPS/Coolify placeholders.
# Copy names into the host secret/environment manager. Do not commit real values.

APP_MODE=deploy
AUTH_REQUIRED=true
SESSION_SECRET=<host-secret-manager-session-secret-min-32-chars>
SQAG_TRACKING_HMAC_KEY=<host-secret-manager-dedicated-tracking-hmac-key>
SQAG_TRACKING_HMAC_KEY_VERSION=<host-configured-tracking-key-version>

SQAG_STORAGE_MODE=database
SQAG_ARTIFACT_STORAGE_MODE=object
SQAG_DATABASE_URL=<host-secret-manager-database-url>
SQAG_OBJECT_STORAGE_PROVIDER=<host-secret-manager-object-storage-provider>
SQAG_OBJECT_STORAGE_ENDPOINT_URL=<host-secret-manager-object-storage-endpoint-url>
SQAG_OBJECT_STORAGE_BUCKET=<host-secret-manager-object-storage-bucket>
SQAG_OBJECT_STORAGE_REGION=<host-secret-manager-object-storage-region>
SQAG_OBJECT_STORAGE_ACCESS_KEY_ID=<host-secret-manager-object-storage-access-key-id>
SQAG_OBJECT_STORAGE_SECRET_ACCESS_KEY=<host-secret-manager-object-storage-secret-access-key>

SQAG_PLATFORM_LAUNCH_MODE=platform
SQAG_PLATFORM_BASE_URL=<host-secret-manager-platform-base-url>
# Explicit reverse-proxy CIDRs only. Do not use catch-all networks.
SQAG_TRUSTED_PROXY_CIDRS=<host-configured-trusted-proxy-cidrs>

# Required by deploy preflight/runtime housekeeping. In this internal-alpha
# posture, quote records must use database storage and generated artifacts
# must use object storage; these roots must not become durable
# product-visible storage.
QUOTE_DATA_ROOT=<host-managed-runtime-root>
QUOTE_OUTPUT_ROOT=<host-managed-output-staging-root>
QUOTE_TMP_ROOT=<host-managed-temp-root>
QUOTE_LOG_ROOT=<host-managed-log-root>

PORT=<host-managed-port>
