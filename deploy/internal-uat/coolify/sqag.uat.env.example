# SQAG internal-alpha VPS/Coolify placeholders.
# Copy names into the host secret/environment manager. Do not commit real values.

APP_MODE=deploy
AUTH_REQUIRED=true
SESSION_SECRET=<host-secret-manager-session-secret>

SQAG_STORAGE_MODE=database
SQAG_ARTIFACT_STORAGE_MODE=database
SQAG_DATABASE_URL=<host-secret-manager-database-url>

SQAG_PLATFORM_LAUNCH_MODE=platform
SQAG_PLATFORM_BASE_URL=<host-secret-manager-platform-base-url>

OIDC_ISSUER_URL=<placeholder>
OIDC_CLIENT_ID=<placeholder>
OIDC_CLIENT_SECRET=<placeholder>
OIDC_REDIRECT_URI=<placeholder>
OIDC_AUTHORIZE_URL=<placeholder>
OIDC_TOKEN_URL=<placeholder>
OIDC_USERINFO_URL=<placeholder>
OIDC_LOGOUT_URL=<optional-placeholder>

AUTH_ALLOWED_EMAILS=<placeholder>
AUTH_ALLOWED_DOMAINS=<placeholder>
AUTH_ALLOW_ANY_AUTHENTICATED_USER=false
AUTH_APPROVED_TESTER_ROLE=admin

# Required by deploy preflight/runtime housekeeping. In this internal-alpha
# posture, quote sessions and generated artifacts must use database storage;
# these roots must not become durable product-visible storage.
QUOTE_DATA_ROOT=<host-managed-runtime-root>
QUOTE_OUTPUT_ROOT=<host-managed-output-staging-root>
QUOTE_TMP_ROOT=<host-managed-temp-root>
QUOTE_LOG_ROOT=<host-managed-log-root>

PORT=<host-managed-port>
