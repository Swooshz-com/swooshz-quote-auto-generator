# OpenAI API for local development.
OPENAI_API_KEY=
OPENAI_DRAFT_MODEL=gpt-5.5
# Normal Start Analysis reasoning effort: none, minimal, low, medium, high, or xhigh.
# Use medium/high for cost control; xhigh is highest quality but can be expensive.
OPENAI_DRAFT_REASONING_EFFORT=high
# High Quality button reasoning effort. Keep xhigh for deliberate expensive reruns.
OPENAI_DRAFT_HIGH_QUALITY_REASONING_EFFORT=xhigh
OPENAI_BASIS_LINE_MODEL=gpt-5.4-mini
OPENAI_BASIS_ANSWER_MODEL=gpt-5.4-nano

# Optional DeepSeek for text-only AI jobs. Full PDF/image draft analysis still uses OpenAI.
# When set, DeepSeek is tried first for Re, basis-chat answers, and pricing-reference import, with OpenAI fallback.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASIS_LINE_MODEL=deepseek-v4-flash
DEEPSEEK_BASIS_ANSWER_MODEL=deepseek-v4-flash
DEEPSEEK_PRICING_IMPORT_MODEL=deepseek-v4-pro
DEEPSEEK_PRICING_METADATA_MODEL=deepseek-v4-flash

# Local app defaults. Keep these for normal desktop development.
APP_MODE=local
# Local dev role: ADMIN, USER, management, operator, or viewer.
USER_TYPE=ADMIN

# Authentication defaults. Deploy mode requires an explicit SQAG_AUTH_MODE,
# AUTH_REQUIRED=true, a strong SESSION_SECRET, and the selected mode's complete
# fail-closed configuration.
SQAG_AUTH_MODE=local
AUTH_REQUIRED=false
SESSION_SECRET=
# Google OIDC settings are used by SQAG_AUTH_MODE=internal_google. Localhost
# OIDC component tests remain isolated under SQAG_AUTH_MODE=local.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_AUTHORIZE_URL=
OIDC_TOKEN_URL=
OIDC_USERINFO_URL=
OIDC_LOGOUT_URL=
# Legacy local-component-test-only settings. They are rejected by
# SQAG_AUTH_MODE=internal_google.
AUTH_ALLOWED_EMAILS=
AUTH_ALLOWED_DOMAINS=
AUTH_ALLOW_ANY_AUTHENTICATED_USER=false
AUTH_APPROVED_TESTER_ROLE=admin
# Temporary internal-alpha exact identity policy. Use server-only configuration.
SQAG_INTERNAL_WORKSPACE_ID=
SQAG_INTERNAL_GOOGLE_IDENTITIES_JSON=
# Deprecated legacy lists are rejected when internal_google is active.
SQAG_INTERNAL_ALLOWED_EMAILS=
SQAG_INTERNAL_ADMIN_EMAILS=
SQAG_INTERNAL_OPERATOR_EMAILS=

# Optional runtime roots for single-instance internal UAT. Keep outside the repo.
QUOTE_DATA_ROOT=
QUOTE_OUTPUT_ROOT=
QUOTE_TMP_ROOT=
QUOTE_LOG_ROOT=

# Mandatory for APP_MODE=deploy. Disabled keeps local/internal mode unchanged.
SQAG_PLATFORM_LAUNCH_MODE=disabled
SQAG_PLATFORM_BASE_URL=https://swooshz.com
SQAG_PUBLIC_BASE_URL=https://quote.swooshz.com
SQAG_PLATFORM_SERVICE_SECRET=
# Optional non-secret bounded timeout (1-30 seconds; default 10).
SQAG_PLATFORM_REQUEST_TIMEOUT_SECONDS=10
# Mandatory for APP_MODE=deploy. Use explicit reverse-proxy CIDRs; catch-all networks are rejected.
SQAG_TRUSTED_PROXY_CIDRS=

# Platform-scoped storage is mandatory for APP_MODE=deploy. Local keeps
# existing localhost runtime JSON/file storage unchanged.
SQAG_STORAGE_MODE=local
SQAG_ARTIFACT_STORAGE_MODE=local
SQAG_DATABASE_URL=sqlite:///C:/path/to/local/sqag-storage.sqlite3
