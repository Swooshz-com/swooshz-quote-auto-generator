# Sole inference gateway. No route defaults or direct-provider fallback.
# Supply reviewed model, literal effort and one-element JSON provider list for each operation.
OPENROUTER_API_KEY=
OPENROUTER_DRAFT_MODEL=
OPENROUTER_DRAFT_REASONING_EFFORT=
OPENROUTER_DRAFT_PROVIDER_ONLY=
OPENROUTER_DRAFT_HIGH_QUALITY_MODEL=
OPENROUTER_DRAFT_HIGH_QUALITY_REASONING_EFFORT=
OPENROUTER_DRAFT_HIGH_QUALITY_PROVIDER_ONLY=
OPENROUTER_BASIS_LINE_MODEL=
OPENROUTER_BASIS_LINE_REASONING_EFFORT=
OPENROUTER_BASIS_LINE_PROVIDER_ONLY=
OPENROUTER_BASIS_ANSWER_MODEL=
OPENROUTER_BASIS_ANSWER_REASONING_EFFORT=
OPENROUTER_BASIS_ANSWER_PROVIDER_ONLY=
OPENROUTER_PRICING_IMPORT_MODEL=
OPENROUTER_PRICING_IMPORT_REASONING_EFFORT=
OPENROUTER_PRICING_IMPORT_PROVIDER_ONLY=
OPENROUTER_PRICING_METADATA_MODEL=
OPENROUTER_PRICING_METADATA_REASONING_EFFORT=
OPENROUTER_PRICING_METADATA_PROVIDER_ONLY=
OPENROUTER_REQUEST_TIMEOUT_SECONDS=
OPENROUTER_REQUIRE_PARAMETERS=true
OPENROUTER_ALLOW_FALLBACKS=false
OPENROUTER_DATA_COLLECTION=deny
OPENROUTER_ZDR=true

# Local app defaults. Keep these for normal desktop development.
APP_MODE=local
# Local dev role: ADMIN, USER, management, operator, or viewer.
USER_TYPE=ADMIN

# Authentication defaults. Deploy mode requires an explicit SQAG_AUTH_MODE,
# AUTH_REQUIRED=true, a strong SESSION_SECRET, and the selected mode's complete
# fail-closed configuration.
SQAG_AUTH_MODE=local
AUTH_REQUIRED=false
SESSION_SECRET=
# Internal group-password access is server-only; stable identity bindings are optional.
# Role lists grant access; optional bindings preserve IDs, including inactive aliases.
# Shared-password holders may select any allowed alias and its configured role.
SQAG_INTERNAL_WORKSPACE_ID=
SQAG_INTERNAL_ALLOWED_EMAILS=
SQAG_INTERNAL_ALLOWED_EMAILS_ADMIN=
SQAG_INTERNAL_IDENTITY_BINDINGS_JSON=
SQAG_INTERNAL_LOGIN_PASSWORD=
SQAG_INTERNAL_ADMIN_LOGIN_PASSWORD=

# Optional runtime roots for single-instance internal UAT. Keep outside the repo.
QUOTE_DATA_ROOT=
QUOTE_OUTPUT_ROOT=
QUOTE_TMP_ROOT=
QUOTE_LOG_ROOT=

# Mandatory for APP_MODE=deploy. Disabled keeps local/internal mode unchanged.
SQAG_PLATFORM_LAUNCH_MODE=disabled
SQAG_PLATFORM_BASE_URL=https://swooshz.com
SQAG_PUBLIC_BASE_URL=https://quote.swooshz.com
SQAG_PLATFORM_SERVICE_SECRET=
# Optional non-secret bounded timeout (1-30 seconds; default 10).
SQAG_PLATFORM_REQUEST_TIMEOUT_SECONDS=10
# Mandatory for APP_MODE=deploy. Use explicit reverse-proxy CIDRs; catch-all networks are rejected.
SQAG_TRUSTED_PROXY_CIDRS=

# Platform-scoped storage is mandatory for APP_MODE=deploy. Local keeps
# existing localhost runtime JSON/file storage unchanged.
SQAG_STORAGE_MODE=local
SQAG_ARTIFACT_STORAGE_MODE=local
SQAG_DATABASE_URL=sqlite:///C:/path/to/local/sqag-storage.sqlite3
