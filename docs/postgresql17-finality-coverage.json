      {"schema_name": "pg_catalog", "catalogue_name": "pg_class", "field_name": "relallvisible", "binding_kind": "system_dynamic", "policy_id": "postgresql-maintained-dynamic-v1", "semantic_family": "visibility_maintenance_estimate", "allowed_postgres_types": ["int4"], "semantic_reason": "PostgreSQL documents this as the estimated number of all-visible pages maintained by VACUUM, ANALYZE, and selected DDL."},
      {"schema_name": "pg_catalog", "catalogue_name": "pg_class", "field_name": "relfrozenxid", "binding_kind": "system_dynamic", "policy_id": "postgresql-maintained-dynamic-v1", "semantic_family": "transaction_age_maintenance_marker", "allowed_postgres_types": ["xid"], "semantic_reason": "The value is maintained by PostgreSQL vacuum/freeze maintenance and is not application identity."},
      {"schema_name": "pg_catalog", "catalogue_name": "pg_class", "field_name": "relminmxid", "binding_kind": "system_dynamic", "policy_id": "postgresql-maintained-dynamic-v1", "semantic_family": "transaction_age_maintenance_marker", "allowed_postgres_types": ["xid"], "semantic_reason": "The value is maintained by PostgreSQL multixact freeze maintenance and is not application identity."},
      {"schema_name": "pg_catalog", "catalogue_name": "pg_class", "field_name": "relfilenode", "binding_kind": "system_dynamic", "policy_id": "postgresql-maintained-dynamic-v1", "semantic_family": "physical_locator", "allowed_postgres_types": ["oid"], "semantic_reason": "The physical file locator can be reassigned by PostgreSQL storage operations; relation identity remains separately normalized."},
      {"schema_name": "pg_catalog", "catalogue_name": "pg_authid", "field_name": "rolpassword", "binding_kind": "secret_shape", "policy_id": "secret-redacted-v1", "semantic_family": "secret_verifier_shape", "allowed_postgres_types": ["text"], "semantic_reason": "Password verifiers are secret-bearing and are represented only by safe presence/type/shape metadata."}
    ],
    "relationship_fields": [
      {"schema_name": "pg_catalog", "catalogue_name": "pg_trigger", "field_name": "tgrelid", "binding_kind": "reference_edge", "policy_id": "stable-reference-edge-v1", "edge_kind": "trigger_targets_relation", "target_catalogue": "pg_catalog.pg_class", "allowed_postgres_types": ["oid"], "semantic_reason": "The trigger target is a stable relation identity edge; raw OID equality is not the semantic contract."},
      {"schema_name": "pg_catalog", "catalogue_name": "pg_class", "field_name": "reltoastrelid", "binding_kind": "reference_edge", "policy_id": "stable-reference-edge-v1", "edge_kind": "relation_has_toast_relation", "target_catalogue": "pg_catalog.pg_class", "allowed_postgres_types": ["oid"], "semantic_reason": "The TOAST relation is a normalized relation identity edge, not a raw OID identity."}
    ],
    "provider_fields": [],
    "deferred_fields": []
  },
  "reference_proof": {
    "minimum_clean_references": 3,
    "raw_variance_receipt": {"encoding": "sha256-canonical-safe-value", "required_fields": ["reference_ids", "catalogue", "field", "object_identity", "policy_id", "value_digests", "distinct_value_count"], "raw_values_emitted": false},
    "normalized_digest": "sha256-canonical-json",
