  "design_lock": "DL-160-POSTMERGE-026-A22R2",
  "postgresql_major": 17,
  "source": {
    "runtime_contract": "docs/runtime-privilege-contract.json",
    "migration_provenance": "docs/runtime-privilege-contract.json#/production_migrations",
    "extractor_id": "postgresql17-system-catalogue-v1",
    "normalizer_id": "postgresql17-finality-normalizer-v1",
    "policy_registry_id": "postgresql17-comparison-policy-registry-v1",
    "reference_topology": "exact canonical migration bytes, order, checksums, ledger provenance, and controlled accepted role/ACL topology"
  },
  "queries": {
    "catalogue_universe": "select n.nspname as schema_name, c.relname as catalogue_name, c.relkind, c.relpersistence, c.relispartition from pg_catalog.pg_class c join pg_catalog.pg_namespace n on n.oid = c.relnamespace where n.nspname = 'pg_catalog' and c.relkind in ('r', 'p', 'v', 'm', 'f', 'c', 'S', 't') order by n.nspname, c.relname, c.relkind",
    "field_universe": "select n.nspname as schema_name, c.relname as catalogue_name, a.attname as field_name, a.attnum as ordinal_position, t.typname as postgres_type, c.relkind, c.relpersistence, c.relispartition, a.attnotnull, a.attgenerated, a.attidentity, a.attstorage from pg_catalog.pg_attribute a join pg_catalog.pg_class c on c.oid = a.attrelid join pg_catalog.pg_namespace n on n.oid = c.relnamespace join pg_catalog.pg_type t on t.oid = a.atttypid where n.nspname = 'pg_catalog' and c.relkind in ('r', 'p', 'v', 'm', 'f', 'c', 'S', 't') and a.attnum > 0 and not a.attisdropped order by n.nspname, c.relname, a.attnum"
  },
  "handling_classes": [
    {"id": "exact_semantic_value", "description": "Raw value is repository semantic state and must compare exactly.", "output_role": "semantic.value"},
    {"id": "stable_normalized_identity_reference_edge", "description": "OID and reference values become stable semantic identities or relationship edges.", "output_role": "semantic.edge"},
    {"id": "canonicalized_collection_set_order", "description": "Collection values compare after deterministic set and order canonicalization.", "output_role": "semantic.collection"},
    {"id": "postgresql_maintained_dynamic_estimate", "description": "PostgreSQL-maintained estimate or maintenance state retains typed shape while raw values may vary under an explicit bounded policy.", "output_role": "semantic.system_state_shape"},
    {"id": "provider_managed_normalized_state", "description": "Provider-managed state retains only the normalized capability and shape needed by the repository boundary.", "output_role": "semantic.provider_state_shape"},
    {"id": "secret_redacted_shape_capability", "description": "Secret-bearing values are never emitted; presence, type, and capability shape remain comparable.", "output_role": "semantic.secret_shape"},
    {"id": "deferred_external_boundary", "description": "An explicitly deferred external boundary is represented as a typed, fail-closed boundary receipt.", "output_role": "semantic.deferred_boundary"}
  ],
  "comparison_policies": [
    {"id": "exact-semantic-v1", "handling_class": "exact_semantic_value", "normalizer": "normalize_exact_value", "allow_raw_variance": false, "shape_fields": ["field_present", "postgres_type", "object_kind", "applicability", "policy_id"], "public_receipt": "exact-value-digest"},
    {"id": "stable-reference-edge-v1", "handling_class": "stable_normalized_identity_reference_edge", "normalizer": "normalize_reference_edge", "allow_raw_variance": true, "shape_fields": ["field_present", "postgres_type", "object_kind", "applicability", "policy_id", "edge_kind"], "public_receipt": "edge-identity-digest"},
    {"id": "canonical-collection-v1", "handling_class": "canonicalized_collection_set_order", "normalizer": "normalize_canonical_collection", "allow_raw_variance": false, "shape_fields": ["field_present", "postgres_type", "object_kind", "applicability", "policy_id"], "public_receipt": "collection-digest"},
    {"id": "postgresql-maintained-dynamic-v1", "handling_class": "postgresql_maintained_dynamic_estimate", "normalizer": "normalize_system_dynamic", "allow_raw_variance": true, "shape_fields": ["field_present", "postgres_type", "object_kind", "applicability", "policy_id", "semantic_family"], "public_receipt": "typed-raw-variance-digest"},
    {"id": "provider-normalized-v1", "handling_class": "provider_managed_normalized_state", "normalizer": "normalize_provider_state", "allow_raw_variance": true, "shape_fields": ["field_present", "postgres_type", "object_kind", "applicability", "policy_id", "capability_shape"], "public_receipt": "provider-shape-digest"},
    {"id": "secret-redacted-v1", "handling_class": "secret_redacted_shape_capability", "normalizer": "normalize_secret_shape", "allow_raw_variance": true, "shape_fields": ["field_present", "postgres_type", "object_kind", "applicability", "policy_id", "secret_shape"], "public_receipt": "secret-safe-shape-digest"},
    {"id": "deferred-external-boundary-v1", "handling_class": "deferred_external_boundary", "normalizer": "normalize_deferred_boundary", "allow_raw_variance": true, "shape_fields": ["field_present", "postgres_type", "object_kind", "applicability", "policy_id", "boundary_id"], "public_receipt": "deferred-boundary-shape-digest"}
  ],
  "field_registry": {
    "mode": "reference_derived_exact_tuple",
    "binding_keys": ["schema_name", "catalogue_name", "field_name", "ordinal_position", "postgres_type", "object_kind", "applicability"],
